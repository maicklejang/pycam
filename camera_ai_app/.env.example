# 사용할 AI: gemini(무료 등급 있음) | ollama(내 PC에서 완전 무료) | openai(유료)
AI_PROVIDER=gemini

# gemini: https://aistudio.google.com/apikey 에서 무료 발급 (카드 등록 불필요)
GEMINI_API_KEY=
# openai: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 모델을 바꾸고 싶을 때만 (기본: gemini-2.5-flash / gemma3 / gpt-4o-mini)
# AI_MODEL=
# ollama가 다른 PC에 있을 때 등 주소를 바꿀 때만
# AI_BASE_URL=http://192.168.0.20:11434/v1

PORT=8000
# 공개 서버에 배포할 때는 꼭 설정하세요 (다른 사람이 내 API 키를 쓰지 못하게)
APP_PASSWORD=
